# =============================================================================
# Kong declarative configuration TEMPLATE (DB-less mode) — §7.2.1, §19.6.
#
# This file is committed; the rendered output (deploy/compose/kong/kong.yml)
# is gitignored. `make refresh-keys` (also run automatically by `make up`
# when the rendered file is missing) substitutes the placeholders below.
#
# Placeholders (each appears verbatim once in this file; the renderer
# substitutes the FIRST occurrence on its own line):
#   KEYCLOAK_REALM_PUBKEY_PEM  — RSA public key from Keycloak, formatted
#                                as a PEM block with 10-space indentation
#                                to land in the right YAML column.
#
# As services are added, register them here through pull requests; CI
# validates the rendered file with `kong config parse`.
# =============================================================================

_format_version: "3.0"
_transform: true

services:
  - name: reference
    url: http://host.docker.internal:7070
    retries: 3
    connect_timeout: 5000
    read_timeout: 30000
    write_timeout: 30000
    tags: [local, reference]
    routes:
      - name: reference-public
        paths:
          - /v1/reference
        strip_path: true
        methods: [GET, POST]
        tags: [local, reference]

# JWT credentials are pinned per consumer.  The `key` MUST equal the `iss`
# claim of the token — Keycloak issues iss=http://localhost:8080/realms/guva
# (the URL the client used to fetch the token).
#
# rsa_public_key is rendered at boot from Keycloak's published realm key
# (see tools/scripts/render-kong-config.sh). The rendered kong.yml is
# gitignored so the key never reaches version control. Production should
# fetch JWKS live — feasible via the Kong Enterprise openid-connect plugin
# (paid) or a small custom plugin.
consumers:
  - username: guva-reference
    tags: [local, reference]
    jwt_secrets:
      - key: http://localhost:8080/realms/guva
        algorithm: RS256
        rsa_public_key: |
__KEYCLOAK_REALM_PUBKEY_PEM__

plugins:
  - name: correlation-id
    config:
      header_name: X-Correlation-Id
      generator: uuid
      echo_downstream: true

  - name: rate-limiting
    config:
      minute: 600
      policy: local
      hide_client_headers: false

  - name: opentelemetry
    config:
      endpoint: http://otel-collector:4318/v1/traces
      headers:
        x-source: kong

  - name: prometheus
    config:
      per_consumer: true
      status_code_metrics: true
      latency_metrics: true
      bandwidth_metrics: true
      upstream_health_metrics: true

  # JWT bearer-token validation on the reference route.
  #
  # The plugin validates the token signature against the RSA public key
  # bound to the consumer whose JWT secret's `key` matches the token's
  # `iss` claim (see consumers block above).  `exp` is also checked.
  #
  # Scope checking is NOT done here — the OSS `jwt` plugin doesn't support
  # it.  The reference service receives the raw Authorization header and
  # enforces scope itself (defence in depth + service-side context).
  - name: jwt
    route: reference-public
    config:
      claims_to_verify:
        - exp
      key_claim_name: iss
      run_on_preflight: false

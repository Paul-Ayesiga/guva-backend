meta {
  name: 06 Signing Pubkey
  type: http
  seq: 7
}

get {
  url: {{directBaseUrl}}/signing-key
  auth: none
}

docs {
  Returns the current Ed25519 public key used to sign assertions.
  Unauthenticated by design — verifiers may need it without ever
  holding a platform token. Hit the direct port (7076) because the
  gateway requires bearer auth on all /v1/consent/* routes.
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("algorithm Ed25519", function() {
    expect(res.body.algorithm).to.equal("Ed25519");
  });
  test("public_key_b64 looks valid", function() {
    expect(res.body.public_key_b64).to.match(/^[A-Za-z0-9+/=]{40,48}$/);
  });
}

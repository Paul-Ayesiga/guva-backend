meta {
  name: 02 Verify Citizen (mismatch)
  type: http
  seq: 3
}

post {
  url: {{apiBaseUrl}}/citizen
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nin": "CM85031298765002",
    "given_name": "John",
    "surname": "Mukasawrong"
  }
}

docs {
  Claimed surname is deliberately wrong. The response surfaces the
  per-attribute mismatch but does NOT echo the correct surname —
  minimum-disclosure means "wrong" without "here's the right answer".

  This is the core API ergonomic property that differs from a
  "give me everything about this person" lookup.
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("verification status mismatch", function() {
    expect(res.body.status).to.equal("mismatch");
  });
  test("surname is the failing attribute", function() {
    expect(res.body.attributes.surname.match).to.equal(false);
    expect(res.body.attributes.given_name.match).to.equal(true);
  });
  test("no PII leak: response does not include actual surname", function() {
    var json = JSON.stringify(res.body);
    expect(json).to.not.include("Mukasa\"");
  });
}

meta {
  name: 01 Healthz
  type: http
  seq: 2
}

get {
  url: {{directBaseUrl}}/healthz
  auth: none
}

docs {
  Liveness probe. Public — no auth required. Hits the service directly
  on :7071 (bypassing the gateway) because /healthz is not gateway-routed.
}

tests {
  test("status is 200", function() { expect(res.status).to.equal(200); });
  test("status field is 'alive'", function() { expect(res.body.status).to.equal("alive"); });
}

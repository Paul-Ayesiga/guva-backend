# =========================================================================
# GUVA local-development environment defaults.
# Copy to `.env` (which is gitignored) and adjust for your machine.
# These values are for LOCAL development only — production secrets are
# never stored in this file; they are issued by Vault per §10.4 of the
# security architecture.
# =========================================================================

# ---- Project ----
COMPOSE_PROJECT_NAME=guva

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=guva
POSTGRES_PASSWORD=guva
POSTGRES_DB=guva

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_BOOTSTRAP_EXTERNAL=localhost:9094

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guva
RABBITMQ_PASSWORD=guva

# ---- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=guva

# ---- Vault (dev mode) ----
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

# ---- MinIO ----
MINIO_ROOT_USER=guva
MINIO_ROOT_PASSWORD=guvaguva

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=guva

# ---- Reference service ----
REFERENCE_HTTP_ADDR=:7070
REFERENCE_LOG_LEVEL=info
